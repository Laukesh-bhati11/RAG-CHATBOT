# =====================================================================
# DocuMind AI - Environment Configuration Example (100% Free / Local)
# =====================================================================
# Rename this file to .env to customize local settings.
# No API keys or credit cards required for local operation!

# Local Ollama LLM Model (e.g., llama3.2:3b, qwen2.5:3b, mistral, llama3.2:1b)
OLLAMA_MODEL=llama3.2:3b

# Ollama Local Service Endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Local Hugging Face Embedding Model (runs on CPU via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Settings (Number of top relevant chunks to retrieve)
TOP_K=4

# Relevance Checking Threshold
RELEVANCE_THRESHOLD=0.3
